      "source": [
        "import re\n",
        "\n",
        "def repeated_letters(text):\n",
        "    if text:\n",
        "        words = text.split()\n",
        "        return sum(1 for word in words if re.search(r\"(.)\\1\", word))\n",
        "    return 0\n",
        "\n",
        "\n",
        "def sentence_count(text):\n",
        "    if text:\n",
        "        return text.count('.') + text.count('؟') + text.count('!')\n",
        "    return 0"
      ],
